    {
      "name": "fable5-codex",
      "version": "1.3.10",
      "description": "Complete source-based Fable 5 workflow for Codex, with engineering references and source traceability.",
      "source": {
        "source": "url",
        "url": "https://github.com/Artypoul/claude-fable-5-system-prompt.git",
        "sha": "7344e0e04c01c5cf7ab14ef36c27839fad19a47b"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity",
      "interface": {
        "displayName": "Fable 5 Codex",
        "shortDescription": "Complete Fable 5 workflow, references and traceability",
        "longDescription": "Source-based Fable 5 baseline with local MCP tools to search enabled Codex skills and read registered SKILL.md files. Includes engineering references, the unchanged original archive, traceability ledger and behavioral evaluation. Requires Node.js 20+ and Codex CLI on PATH. Uses the host's actual tools and permissions.",
        "developerName": "Artypoul",
        "category": "Productivity",
        "defaultPrompt": [
          "Use $fable5-codex:fable5-codex for this task, loading the relevant source-based sections and engineering references."
        ]
      }
    },
    {
      "name": "superpowers",
      "version": "7.0.2",
      "description": "Upstream engineering skills for planning, TDD, debugging, parallel execution and code review, pinned as a complete Codex package.",
      "source": {
        "source": "url",
        "url": "https://github.com/obra/superpowers.git",
        "sha": "22f0b463e7a5e579904dd6211a520321035526f7"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools",
      "interface": {
        "displayName": "Superpowers",
        "shortDescription": "Planning, TDD, debugging and code review",
        "longDescription": "Complete upstream Superpowers package for Codex. Uses its native Codex manifest with shared hooks disabled. The portable Gigma profile configures cooperation with Fable 5, reusing existing plans and verification evidence.",
        "developerName": "Jesse Vincent",
        "category": "Developer Tools",
        "defaultPrompt": [
          "Use the relevant Superpowers engineering skills for this task, reusing existing requirements, plans and verification evidence."
        ]
      }
    },
    {
      "name": "gigma-mcp",
      "version": "0.2.0",
      "description": "Connect an agent to the Gigma owner MCP through native callback onboarding.",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/Artypoul/gigma-mcp.git",
        "path": "plugins/gigma-mcp",
        "sha": "2d9332aa90baa51a09f4d9ef29127c4a2c71979c"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity",
      "interface": {
        "displayName": "Gigma MCP",
        "shortDescription": "Connect an AI agent to Gigma.",
        "longDescription": "Connect Codex and compatible agents to the Gigma owner MCP through a native callback flow.",
        "developerName": "Gigma",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Use Gigma MCP to connect my owner workspace through the native callback flow."
        ]
      }
    },
