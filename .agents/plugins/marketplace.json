        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity",
      "interface": {
        "displayName": "Gigma MCP",
        "shortDescription": "Connect an AI agent to Gigma.",
        "longDescription": "Connect Codex and compatible agents to the Gigma owner MCP through a native callback flow.",
        "developerName": "Gigma",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Use Gigma MCP to connect my owner workspace through the native callback flow."
        ]
      }
    }
